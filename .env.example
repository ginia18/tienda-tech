# Copia este archivo a .env (cp .env.example .env) y cambia los valores.
# NO subas el archivo .env al repositorio.

# Credenciales de PostgreSQL (elige las tuyas; no uses estas en produccion)
POSTGRES_USER=tienda_user
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=tienda_db

# Puerto de la API en tu maquina (http://localhost:APP_PORT)
APP_PORT=3000

# Puerto de PostgreSQL expuesto en tu maquina (opcional, para usar psql desde fuera)
DB_PORT_HOST=5433
